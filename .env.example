# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# CONFIGURATION SERVEUR AUTONOME (DOCKER / VM FREEBOX)
# ==============================================================================
# Aucun serveur MySQL ou Firebase requis !
# Les données sont stockées de façon permanente dans le volume ./data/
PORT="3000"
NODE_ENV="production"
